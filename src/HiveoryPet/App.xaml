<Application
    x:Class="HiveoryPet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Nothing-style: white, greys, and red only when you're needed. -->
            <SolidColorBrush x:Key="PetInk" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PetSoft" Color="#D6D6D6" />
            <SolidColorBrush x:Key="PetMuted" Color="#8F8F8F" />
            <SolidColorBrush x:Key="PetLine" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="PetAlert" Color="#FF3B30" />
            <FontFamily x:Key="PetMono">Cascadia Mono, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
