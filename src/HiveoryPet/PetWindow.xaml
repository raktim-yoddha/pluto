<Window
    x:Class="HiveoryPet.PetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HiveoryPet"
    Title="Hiveory Pet">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="OnPressed"
        PointerMoved="OnMoved"
        PointerReleased="OnReleased"
        PointerCaptureLost="OnCaptureLost"
        PointerEntered="OnEntered"
        PointerExited="OnExited"
        RightTapped="OnRightTapped">

        <StackPanel x:Name="Stage" VerticalAlignment="Top">
            <!-- The face, what's going on, and Settings. -->
            <Grid x:Name="Head" Height="56">
                <!-- Tucked into the notch: just the eyes. -->
                <local:BotFace
                    x:Name="TuckedFace"
                    EyesOnly="True"
                    Width="44"
                    Height="20"
                    Margin="0,3,0,3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Tucked'), Mode=OneWay}">
                    <local:BotFace.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.167" />
                    </local:BotFace.OpacityTransition>
                </local:BotFace>

                <!-- Floating and quiet: the face alone, centred both ways. -->
                <local:BotFace
                    x:Name="SoloFace"
                    Width="48"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Face'), Mode=OneWay}">
                    <local:BotFace.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.167" />
                    </local:BotFace.OpacityTransition>
                </local:BotFace>

                <Grid
                    Padding="12,0,12,0"
                    ColumnSpacing="12"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Compact,List'), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.167" />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <local:BotFace x:Name="Face" Width="48" Height="38" VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Compact,List'), Mode=OneWay}">
                        <StackPanel.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.25" />
                        </StackPanel.OpacityTransition>
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSettingsClick"
                        Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Compact,List'), Mode=OneWay}"
                        IsHitTestVisible="{x:Bind local:Ui.Hit(ViewModel.Look, 'Compact,List'), Mode=OneWay}"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                        <Button.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.25" />
                        </Button.OpacityTransition>
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </Grid>

            <!-- Every session. -->
            <StackPanel
                x:Name="Panel"
                Width="360"
                Padding="4,0,4,6"
                Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'List'), Mode=OneWay}"
                IsHitTestVisible="{x:Bind local:Ui.Hit(ViewModel.Look, 'List'), Mode=OneWay}">
                <StackPanel.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25" />
                </StackPanel.OpacityTransition>
                <!-- With a Hiveory linked: its agents, and every other one. Pointing at a tab opens it. -->
                <SelectorBar
                    x:Name="Sections"
                    Margin="4,0,4,2"
                    Visibility="{x:Bind local:Ui.Shown(ViewModel.HiveoryLinked), Mode=OneWay}"
                    SelectionChanged="OnSectionChanged"
                    AutomationProperties.Name="Agents in Hiveory or outside it">
                    <SelectorBarItem
                        x:Name="HiveoryItem"
                        Text="{x:Bind ViewModel.HiveoryTab, Mode=OneWay}"
                        IsSelected="True"
                        PointerEntered="OnSectionHover" />
                    <SelectorBarItem
                        x:Name="OutsideItem"
                        Text="{x:Bind ViewModel.OutsideTab, Mode=OneWay}"
                        PointerEntered="OnSectionHover" />
                </SelectorBar>
                <ListView
                    MaxHeight="384"
                    ItemsSource="{x:Bind ViewModel.VisibleRows, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnRowClick"
                    AutomationProperties.Name="Agent sessions">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Row">
                            <Grid MinHeight="52" Padding="0,6,0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="20" Height="20" VerticalAlignment="Center" Source="{x:Bind local:Ui.Icon(Icon)}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind local:Ui.Detail(Activity, Subtitle)}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Time}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <ProgressRing Width="14" Height="14" IsActive="True" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'working')}" />
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'needs')}" />
                                        <InfoBadge HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SuccessDotInfoBadgeStyle}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'done')}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Margin="16,8,16,10"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:Ui.Shown(ViewModel.IsEmpty), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
