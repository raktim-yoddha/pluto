<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pet's window: WinUI 3 (Windows App SDK), unpackaged. Published as one native exe (NativeAOT, no .NET needed)
       on Windows' shared Windows App Runtime, which WindowsAppRuntime.cs installs once if it is missing: carrying our
       own copy of either made the installer 100 MB. Only the WinUI parts of the SDK, not its AI/ML libraries. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Pluto</RootNamespace>
    <AssemblyName>Pluto</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Program.cs starts the runtime itself, after Velopack and with an install offer when it is missing. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Logo\pluto.ico</ApplicationIcon>
    <Product>Pluto</Product>
    <!-- Program.cs is the entry point, so Velopack runs before anything else. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <!-- Official agent marks, from Hiveory (scripts/import-icons.mjs). -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pluto.Core\Pluto.Core.csproj" />
  </ItemGroup>
  <!-- The hook relay ships next to the app; the pet copies it to a stable folder on start. -->
  <Target Name="BundleRelay" AfterTargets="Build">
    <MSBuild Projects="..\Pluto.Hook\Pluto.Hook.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <RelayFiles Include="..\Pluto.Hook\bin\$(Configuration)\net10.0-windows\win-x64\pluto-hook.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RelayFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
