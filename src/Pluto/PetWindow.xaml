<Window
    x:Class="Pluto.PetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pluto"
    xmlns:todos="using:Pluto.Todos"
    Title="Pluto">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="OnPressed"
        PointerMoved="OnMoved"
        PointerReleased="OnReleased"
        PointerCaptureLost="OnCaptureLost"
        PointerEntered="OnEntered"
        PointerExited="OnExited"
        KeyDown="OnRootKeyDown"
        RightTapped="OnRightTapped">

        <!-- Pluto's body: drawn on the compositor (NotchSurface), behind everything. -->
        <Grid x:Name="ShapeHost" IsHitTestVisible="False" />

        <!-- What sits on the body, clipped to its shape. Each look has its own spot; the body moves between them. -->
        <Canvas x:Name="Stage">
            <!-- In the notch: just the eyes. -->
            <local:BotFace
                x:Name="TuckedFace"
                EyesOnly="True"
                Width="44"
                Height="20"
                Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Tucked'), Mode=OneWay}">
                <local:BotFace.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.1" />
                </local:BotFace.OpacityTransition>
                <local:BotFace.ScaleTransition>
                    <Vector3Transition Duration="0:0:0.25" />
                </local:BotFace.ScaleTransition>
            </local:BotFace>

            <!-- Floating: the face alone. -->
            <local:BotFace
                x:Name="SoloFace"
                Width="48"
                Height="38"
                Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Face'), Mode=OneWay}">
                <local:BotFace.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.167" />
                </local:BotFace.OpacityTransition>
                <local:BotFace.ScaleTransition>
                    <Vector3Transition Duration="0:0:0.25" />
                </local:BotFace.ScaleTransition>
            </local:BotFace>

            <!-- Something happened: one line about it, always this size, for a moment. -->
            <Grid
                x:Name="NoteLayer"
                Width="320"
                Height="56"
                Padding="12,0,16,0"
                ColumnSpacing="12"
                Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Note'), Mode=OneWay}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{x:Bind ViewModel.NoteTitle, Mode=OneWay}">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.12" />
                </Grid.OpacityTransition>
                <Grid.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.22" />
                </Grid.TranslationTransition>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:BotFace x:Name="NoteFace" Width="48" Height="38" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="NoteTitle"
                        Text="{x:Bind ViewModel.NoteTitle, Mode=OneWay}"
                        FontFamily="{ThemeResource PlutoDisplayFont}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="NoteText"
                        Text="{x:Bind ViewModel.NoteText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Image x:Name="NoteIcon" Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center" Source="{x:Bind local:Ui.Icon(ViewModel.NoteIcon), Mode=OneWay}" />
            </Grid>

            <!-- The open list: its heading and its sections. -->
            <StackPanel x:Name="ListLayer" Width="380">
                <StackPanel.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.34" />
                </StackPanel.TranslationTransition>
                <Grid
                    Height="56"
                    Padding="12,0,10,0"
                    ColumnSpacing="12"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'List'), Mode=OneWay}"
                    IsHitTestVisible="{x:Bind local:Ui.Hit(ViewModel.Look, 'List'), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:BotFace x:Name="Face" Width="48" Height="38" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <StackPanel
                x:Name="Panel"
                Width="380"
                Padding="4,0,4,8"
                Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'List'), Mode=OneWay}"
                IsHitTestVisible="{x:Bind local:Ui.Hit(ViewModel.Look, 'List'), Mode=OneWay}">
                <StackPanel.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </StackPanel.OpacityTransition>

                <!-- Tiny section labels. Pointing at one opens it. -->
                <!-- The sections: click one. A soft pill behind the chosen one glides between them. -->
                <Grid Margin="10,2,0,8" HorizontalAlignment="Left">
                    <Grid x:Name="TabPillHost" IsHitTestVisible="False" />
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="Sections">
                        <RadioButton x:Name="AllTab" Content="All" GroupName="Sections" IsChecked="True" Style="{StaticResource PlutoTabStyle}" Checked="OnTabChecked" />
                        <RadioButton x:Name="HiveoryTab" Content="Hiveory" GroupName="Sections" Style="{StaticResource PlutoTabStyle}" Checked="OnTabChecked" Visibility="{x:Bind local:Ui.Shown(ViewModel.ShowHiveory), Mode=OneWay}" />
                        <RadioButton x:Name="TodoTab" Content="To Do" GroupName="Sections" Style="{StaticResource PlutoTabStyle}" Checked="OnTabChecked" />
                    </StackPanel>
                </Grid>

                <!-- Agents. -->
                <StackPanel Visibility="{x:Bind local:Ui.Shown(ViewModel.ShowAgents), Mode=OneWay}">
                    <ListView
                        MaxHeight="384"
                        ItemsSource="{x:Bind ViewModel.VisibleRows}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnRowClick"
                        AutomationProperties.Name="Agent sessions">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AgentRow">
                                <Grid MinHeight="52" Padding="0,6,0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="20" Height="20" VerticalAlignment="Center" Source="{x:Bind local:Ui.Icon(Icon), Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Where, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid ColumnSpacing="5" Visibility="{x:Bind local:Ui.ShownEither(Place, Activity), Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                Glyph="&#xE8B7;"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind local:Ui.Shown(Place), Mode=OneWay}"
                                                AutomationProperties.Name="Folder" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind local:Ui.Detail(Place, Activity), Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Time, Mode=OneWay}"
                                            FontFamily="{ThemeResource PlutoDisplayFont}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                            <ProgressRing Width="14" Height="14" IsActive="True" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'working'), Mode=OneWay}" />
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'needs'), Mode=OneWay}" />
                                            <InfoBadge HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SuccessDotInfoBadgeStyle}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'done'), Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Margin="16,6,16,10"
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:Ui.Shown(ViewModel.IsEmpty), Mode=OneWay}" />
                </StackPanel>

                <!-- To Do. -->
                <StackPanel Padding="12,2,12,0" Spacing="8" Visibility="{x:Bind local:Ui.Shown(ViewModel.ShowTodo), Mode=OneWay}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.Todo.Title, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.Todo.Count, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind local:Ui.Shown(ViewModel.Todo.ShowCount), Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Value="{x:Bind ViewModel.Todo.Percent, Mode=OneWay}"
                        Maximum="100"
                        Visibility="{x:Bind local:Ui.Shown(ViewModel.Todo.ShowBar), Mode=OneWay}"
                        AutomationProperties.Name="Done so far" />
                    <!-- Adding a task: a soft rounded field with a plus; Enter (or the return key on the right) adds it. -->
                    <Grid Height="40">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" />
                    <Border
                        x:Name="AddEdge"
                        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Opacity="0">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                    </Border>
                    <Grid Padding="12,0,4,0" ColumnSpacing="10">
                            <Grid.Resources>
                                <!-- The field draws nothing of its own: the row is the field. -->
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="AddIcon" VerticalAlignment="Center" Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.45">
                                <FontIcon.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </FontIcon.OpacityTransition>
                            </FontIcon>
                            <TextBox
                                x:Name="AddBox"
                                Grid.Column="1"
                                MinHeight="0"
                                Padding="0,0,0,1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                PlaceholderText="Add a task"
                                KeyDown="OnAddKeyDown"
                                TextChanged="OnAddTextChanged"
                                GotFocus="OnAddFocus"
                                LostFocus="OnAddFocus"
                                AutomationProperties.Name="Add a task" />
                            <Button
                                x:Name="AddButton"
                                Grid.Column="2"
                                Style="{StaticResource PlutoIconButtonStyle}"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Click="OnAddClick"
                                ToolTipService.ToolTip="Add (Enter)"
                                AutomationProperties.Name="Add">
                                <Button.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </Button.OpacityTransition>
                                <FontIcon Glyph="&#xE751;" FontSize="12" />
                            </Button>
                    </Grid>
                    </Grid>
                    <ListView
                        x:Name="TodoList"
                        MaxHeight="320"
                        Margin="-12,0,-12,0"
                        ItemsSource="{x:Bind ViewModel.Todo.Items}"
                        SelectionMode="None"
                        AutomationProperties.Name="Today's tasks">
                        <!-- Rows move by hand (drag the grip), so no built-in item animations get in the way. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="todos:TodoItemViewModel">
                                <Grid
                                    MinHeight="40"
                                    ColumnSpacing="6"
                                    Background="Transparent"
                                    Tag="{x:Bind Id}"
                                    PointerEntered="OnTodoEnter"
                                    PointerExited="OnTodoExit"
                                    DoubleTapped="OnTodoDoubleTapped"
                                    KeyDown="OnTodoKeyDown"
                                    AutomationProperties.Name="{x:Bind Text}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="18"
                                        Height="32"
                                        Margin="-8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Tag="{x:Bind Id}"
                                        PointerPressed="OnGripPressed"
                                        PointerMoved="OnGripMoved"
                                        PointerReleased="OnGripReleased"
                                        PointerCaptureLost="OnGripLost"
                                        AutomationProperties.Name="Move (Alt+Up or Alt+Down)">
                                        <FontIcon Glyph="&#xE76F;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0">
                                            <FontIcon.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.15" />
                                            </FontIcon.OpacityTransition>
                                        </FontIcon>
                                    </Border>
                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind Completed}"
                                        Tag="{x:Bind Id}"
                                        Click="OnTodoChecked"
                                        AutomationProperties.Name="{x:Bind Text}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Text}"
                                        Opacity="{x:Bind TextOpacity}"
                                        TextDecorations="{x:Bind local:Ui.Strike(Struck)}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind local:Ui.Hidden(IsEditing), Mode=OneWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Text}"
                                        Tag="{x:Bind Id}"
                                        KeyDown="OnEditKeyDown"
                                        LostFocus="OnEditLostFocus"
                                        Visibility="{x:Bind local:Ui.Shown(IsEditing), Mode=OneWay}"
                                        AutomationProperties.Name="Rename task" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind CompletedAt}"
                                        FontFamily="{ThemeResource PlutoDisplayFont}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal" Opacity="0">
                                        <StackPanel.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.15" />
                                        </StackPanel.OpacityTransition>
                                        <Button Style="{StaticResource PlutoIconButtonStyle}" Tag="{x:Bind Id}" Click="OnEditClick" ToolTipService.ToolTip="Rename (F2)" AutomationProperties.Name="Rename">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource PlutoIconButtonStyle}" Tag="{x:Bind Id}" Click="OnDeleteClick" ToolTipService.ToolTip="Delete (Del)" AutomationProperties.Name="Delete">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Margin="0,0,0,6"
                        Text="Nothing on today's list yet."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind local:Ui.Shown(ViewModel.Todo.IsEmpty), Mode=OneWay}" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
