<Window x:Class="HiveoryPet.Ui.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HiveoryPet.Ui"
        Title="Hiveory Pet"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Nothing-style: black, white, grey; red only when you're needed. -->
    <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Soft" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Muted" Color="#7E7E7E" />
    <SolidColorBrush x:Key="Line" Color="#262626" />
    <SolidColorBrush x:Key="Hover" Color="#141414" />
    <SolidColorBrush x:Key="Alert" Color="#D71921" />
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Bare" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Bare}">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{StaticResource Ink}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="#000000" TextElement.FontWeight="SemiBold" TextElement.FontSize="11" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Soft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="RowTemplate">
      <Button Style="{StaticResource Bare}" Padding="10,8" Click="OnRowClick" Tag="{Binding}"
              AutomationProperties.Name="{Binding Title}" ToolTip="Bring its window forward">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Stroke="{StaticResource Muted}" StrokeThickness="1.5" />
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
              <Border x:Name="Tag" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                      Padding="5,0" Margin="6,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="HIVEORY" FontFamily="{StaticResource Mono}" FontSize="8.5" Foreground="{StaticResource Muted}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            <TextBlock Text="{Binding Activity}" FontSize="11.5" Foreground="{StaticResource Soft}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Time}" FontFamily="{StaticResource Mono}" FontSize="10.5"
                     Foreground="{StaticResource Muted}" Margin="8,2,0,0" VerticalAlignment="Top" />
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Working">
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Ink}" />
          <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Ink}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NeedsYou">
          <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Alert}" />
          <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Alert}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding JustFinished}" Value="True">
          <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Ink}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding FromHiveory}" Value="True">
          <Setter TargetName="Tag" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Shell" Background="#000000" BorderBrush="{StaticResource Line}" BorderThickness="1"
          MouseLeftButtonDown="OnShellDown" MouseMove="OnShellMove" MouseLeftButtonUp="OnShellUp"
          MouseEnter="OnShellEnter" MouseLeave="OnShellLeave" ContextMenuOpening="OnMenuOpening">
    <Border.ContextMenu>
      <ContextMenu />
    </Border.ContextMenu>
    <StackPanel>
      <!-- Tucked against the screen edge: just the eyes. -->
      <ui:BotFace x:Name="TuckedFace" EyesOnly="True" Width="44" Height="12" Margin="16,5" />

      <!-- The face, what's going on, and the actions. -->
      <Grid x:Name="Head" Margin="8,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:BotFace x:Name="Face" Width="46" Height="36" />
        <StackPanel x:Name="Texts" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SubText" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
        </StackPanel>
        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Bare}" Padding="8,6" Click="OnMenuClick" AutomationProperties.Name="Settings" ToolTip="Settings">
            <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Soft}" />
          </Button>
          <Button Style="{StaticResource Bare}" Padding="8,6" Click="OnCollapseClick" AutomationProperties.Name="Close the list" ToolTip="Close">
            <TextBlock x:Name="CollapseGlyph" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Soft}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Every session. -->
      <StackPanel x:Name="Panel" Margin="6,0,6,8">
        <Line X1="0" X2="1" Stretch="Fill" Stroke="{StaticResource Line}" StrokeDashArray="1 3" StrokeThickness="2" Margin="8,0,8,4" />
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="List" ItemTemplate="{StaticResource RowTemplate}" />
        </ScrollViewer>
        <TextBlock x:Name="Empty" Margin="12,10" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        <Line X1="0" X2="1" Stretch="Fill" Stroke="{StaticResource Line}" StrokeDashArray="1 3" StrokeThickness="2" Margin="8,4" />
        <Grid Margin="12,4,8,0">
          <TextBlock x:Name="FooterText" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
          <Button x:Name="FooterButton" Style="{StaticResource Chip}" HorizontalAlignment="Right" Click="OnFooterClick" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
