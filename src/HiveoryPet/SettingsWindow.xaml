<Window
    x:Class="HiveoryPet.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HiveoryPet"
    Title="Hiveory Pet settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="Bar" Title="Hiveory Pet" Subtitle="Settings" />

        <ScrollViewer Grid.Row="1" Padding="36,0,36,0">
            <StackPanel MaxWidth="760" Padding="0,8,0,36" Spacing="4">
                <TextBlock Margin="0,0,0,4" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

                <InfoBar
                    IsOpen="{x:Bind local:Ui.HasText(ViewModel.Notice), Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Informational"
                    CloseButtonClick="OnNoticeClosed" />

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Position" />
                <local:SettingCard
                    Glyph="&#xE7C4;"
                    Header="Where the pet lives"
                    Description="In a notch on the top edge, or floating anywhere. Drag the pet to move it.">
                    <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.DockChoice, Mode=TwoWay}" AutomationProperties.Name="Where the pet lives">
                        <x:String>Top edge</x:String>
                        <x:String>Floating</x:String>
                    </ComboBox>
                </local:SettingCard>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Agents to watch" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Agents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AgentToggle">
                            <local:SettingCard Glyph="&#xE99A;" Header="{x:Bind Name}" Description="{x:Bind Detail, Mode=OneWay}">
                                <ToggleSwitch
                                    MinWidth="0"
                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    AutomationProperties.Name="{x:Bind Name}" />
                            </local:SettingCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Hiveory" />
                <local:SettingCard Glyph="&#xE71B;" Header="Show Hiveory's agents" Description="{x:Bind ViewModel.HiveoryStatus, Mode=OneWay}">
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.WatchHiveory, Mode=TwoWay}"
                        OnContent=""
                        OffContent=""
                        AutomationProperties.Name="Show Hiveory's agents" />
                </local:SettingCard>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="General" />
                <local:SettingCard Glyph="&#xE767;" Header="Sounds" Description="A soft chime when an agent finishes or needs you">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.Sounds, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="Sounds" />
                </local:SettingCard>
                <local:SettingCard Glyph="&#xE7E8;" Header="Start with Windows" Description="Open the pet when you sign in">
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="Start with Windows" />
                </local:SettingCard>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="About" />
                <local:SettingCard Glyph="&#xE946;" Header="Hiveory Pet" Description="{x:Bind Version}">
                    <Button Content="Quit" Click="OnQuit" AutomationProperties.Name="Quit Hiveory Pet" />
                </local:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
