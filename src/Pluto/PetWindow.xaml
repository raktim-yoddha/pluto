<Window
    x:Class="Pluto.PetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pluto"
    xmlns:todos="using:Pluto.Todos"
    Title="Pluto">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="OnPressed"
        PointerMoved="OnMoved"
        PointerReleased="OnReleased"
        PointerCaptureLost="OnCaptureLost"
        PointerEntered="OnEntered"
        PointerExited="OnExited"
        RightTapped="OnRightTapped">

        <StackPanel x:Name="Stage" VerticalAlignment="Top">
            <Grid x:Name="Head" Height="56">
                <!-- In the notch: just the eyes. -->
                <local:BotFace
                    x:Name="TuckedFace"
                    EyesOnly="True"
                    Width="44"
                    Height="20"
                    Margin="0,3,0,3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Tucked'), Mode=OneWay}">
                    <local:BotFace.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.167" />
                    </local:BotFace.OpacityTransition>
                </local:BotFace>

                <!-- Floating: the face alone, centred both ways. -->
                <local:BotFace
                    x:Name="SoloFace"
                    Width="48"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Face'), Mode=OneWay}">
                    <local:BotFace.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.167" />
                    </local:BotFace.OpacityTransition>
                </local:BotFace>

                <!-- Something happened: one line about it, always this size, for a moment. -->
                <Grid
                    x:Name="NoteLayer"
                    Padding="12,0,16,0"
                    ColumnSpacing="12"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'Note'), Mode=OneWay}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind ViewModel.NoteTitle, Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </Grid.OpacityTransition>
                    <Grid.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.22" />
                    </Grid.TranslationTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:BotFace x:Name="NoteFace" Width="48" Height="38" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.NoteTitle, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ViewModel.NoteText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Image Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center" Source="{x:Bind local:Ui.Icon(ViewModel.NoteIcon), Mode=OneWay}" />
                </Grid>

                <!-- The list's heading: the face, who needs you or works, and Settings. -->
                <Grid
                    Padding="12,0,10,0"
                    ColumnSpacing="12"
                    Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'List'), Mode=OneWay}"
                    IsHitTestVisible="{x:Bind local:Ui.Hit(ViewModel.Look, 'List'), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:BotFace x:Name="Face" Width="48" Height="38" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </Grid>

            <!-- The list. -->
            <StackPanel
                x:Name="Panel"
                Width="380"
                Padding="4,0,4,8"
                Opacity="{x:Bind local:Ui.Show(ViewModel.Look, 'List'), Mode=OneWay}"
                IsHitTestVisible="{x:Bind local:Ui.Hit(ViewModel.Look, 'List'), Mode=OneWay}">
                <StackPanel.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </StackPanel.OpacityTransition>

                <!-- Tiny section labels. Pointing at one opens it. -->
                <StackPanel Margin="10,0,0,6" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Sections">
                    <RadioButton x:Name="AllTab" Content="All" GroupName="Sections" IsChecked="True" Style="{StaticResource PlutoTabStyle}" Checked="OnTabChecked" PointerEntered="OnTabHover" />
                    <RadioButton x:Name="HiveoryTab" Content="Hiveory" GroupName="Sections" Style="{StaticResource PlutoTabStyle}" Checked="OnTabChecked" PointerEntered="OnTabHover" Visibility="{x:Bind local:Ui.Shown(ViewModel.ShowHiveory), Mode=OneWay}" />
                    <RadioButton x:Name="TodoTab" Content="To Do" GroupName="Sections" Style="{StaticResource PlutoTabStyle}" Checked="OnTabChecked" PointerEntered="OnTabHover" />
                </StackPanel>

                <!-- Agents. -->
                <StackPanel Visibility="{x:Bind local:Ui.Shown(ViewModel.ShowAgents), Mode=OneWay}">
                    <ListView
                        MaxHeight="384"
                        ItemsSource="{x:Bind ViewModel.VisibleRows, Mode=OneWay}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnRowClick"
                        AutomationProperties.Name="Agent sessions">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Row">
                                <Grid MinHeight="52" Padding="0,6,0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="20" Height="20" VerticalAlignment="Center" Source="{x:Bind local:Ui.Icon(Icon)}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Where}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid ColumnSpacing="5" Visibility="{x:Bind local:Ui.ShownEither(Place, Activity)}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                Glyph="&#xE8B7;"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind local:Ui.Shown(Place)}"
                                                AutomationProperties.Name="Folder" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind local:Ui.Detail(Place, Activity)}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Time}"
                                            FontFamily="{ThemeResource PlutoDisplayFont}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                            <ProgressRing Width="14" Height="14" IsActive="True" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'working')}" />
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'needs')}" />
                                            <InfoBadge HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SuccessDotInfoBadgeStyle}" Visibility="{x:Bind local:Ui.Status(State, JustFinished, 'done')}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Margin="16,6,16,10"
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:Ui.Shown(ViewModel.IsEmpty), Mode=OneWay}" />
                </StackPanel>

                <!-- To Do. -->
                <StackPanel Padding="12,2,12,0" Spacing="8" Visibility="{x:Bind local:Ui.Shown(ViewModel.ShowTodo), Mode=OneWay}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.Todo.Title, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.Todo.Count, Mode=OneWay}"
                            FontFamily="{ThemeResource PlutoDisplayFont}"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind local:Ui.Shown(ViewModel.Todo.ShowCount), Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Value="{x:Bind ViewModel.Todo.Percent, Mode=OneWay}"
                        Maximum="100"
                        Visibility="{x:Bind local:Ui.Shown(ViewModel.Todo.ShowBar), Mode=OneWay}"
                        AutomationProperties.Name="Done so far" />
                    <TextBox
                        x:Name="AddBox"
                        PlaceholderText="Add a task"
                        KeyDown="OnAddKeyDown"
                        AutomationProperties.Name="Add a task" />
                    <ListView
                        x:Name="TodoList"
                        MaxHeight="320"
                        Margin="-12,0,-12,0"
                        ItemsSource="{x:Bind ViewModel.Todo.Items}"
                        SelectionMode="None"
                        CanReorderItems="True"
                        CanDragItems="True"
                        AllowDrop="True"
                        DragItemsCompleted="OnTodoDragged"
                        AutomationProperties.Name="Today's tasks">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="todos:TodoItemViewModel">
                                <Grid MinHeight="40" ColumnSpacing="4" Background="Transparent" RightTapped="OnTodoRightTapped" Tag="{x:Bind Id}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind Completed}"
                                        Tag="{x:Bind Id}"
                                        Click="OnTodoChecked"
                                        AutomationProperties.Name="{x:Bind Text}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Text}"
                                        Opacity="{x:Bind TextOpacity}"
                                        TextDecorations="{x:Bind local:Ui.Strike(Struck)}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind CompletedAt}"
                                        FontFamily="{ThemeResource PlutoDisplayFont}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Margin="0,0,0,6"
                        Text="Nothing on today's list yet."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind local:Ui.Shown(ViewModel.Todo.IsEmpty), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
